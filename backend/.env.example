# PostgreSQL connection string (Neon, Supabase, or any Postgres host)
# Example (Neon):   postgresql://user:password@ep-xxxx.neon.tech/portfolio?sslmode=require
# Example (Supabase): postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="portfolio_token"

# Admin account (used by prisma/seed.js to create your first admin login)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Your Name"
